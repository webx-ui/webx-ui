<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="WebX UI">
            <directory>packages/module-admin/tests</directory>
            <directory>packages/localization/tests</directory>
            <directory>packages/mcp/tests</directory>
            <directory>packages/module-auth/tests</directory>
            <directory>packages/module-blocks/tests</directory>
            <directory>packages/module-blog/tests</directory>
            <directory>packages/module-faq/tests</directory>
            <directory>packages/module-inbox/tests</directory>
            <directory>packages/module-media/tests</directory>
            <directory>packages/module-menu/tests</directory>
            <directory>packages/module-pages/tests</directory>
            <directory>packages/module-seo/tests</directory>
            <directory>packages/module-services/tests</directory>
            <directory>packages/module-settings/tests</directory>
            <directory>packages/nested-set/tests</directory>
            <directory>packages/routing/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>packages/module-admin/src</directory>
            <directory>packages/localization/src</directory>
            <directory>packages/mcp/src</directory>
            <directory>packages/module-auth/src</directory>
            <directory>packages/module-blocks/src</directory>
            <directory>packages/module-blog/src</directory>
            <directory>packages/module-faq/src</directory>
            <directory>packages/module-inbox/src</directory>
            <directory>packages/module-media/src</directory>
            <directory>packages/module-menu/src</directory>
            <directory>packages/module-pages/src</directory>
            <directory>packages/module-seo/src</directory>
            <directory>packages/module-services/src</directory>
            <directory>packages/module-settings/src</directory>
            <directory>packages/nested-set/src</directory>
            <directory>packages/routing/src</directory>
        </include>
    </source>
</phpunit>
