<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="WebX UI">
            <directory>packages/admin/tests</directory>
            <directory>packages/mcp/tests</directory>
            <directory>packages/module-auth/tests</directory>
            <directory>packages/nested-set/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>packages/admin/src</directory>
            <directory>packages/mcp/src</directory>
            <directory>packages/module-auth/src</directory>
            <directory>packages/nested-set/src</directory>
        </include>
    </source>
</phpunit>
