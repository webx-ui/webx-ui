includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - packages/module-admin/src
        - packages/module-admin/tests
        - packages/localization/src
        - packages/localization/tests
        - packages/mcp/src
        - packages/mcp/tests
        - packages/module-auth/src
        - packages/module-auth/tests
        - packages/module-blocks/src
        - packages/module-blocks/tests
        - packages/module-inbox/src
        - packages/module-inbox/tests
        - packages/module-media/src
        - packages/module-media/tests
        - packages/module-pages/src
        - packages/module-pages/tests
        - packages/module-seo/src
        - packages/module-seo/tests
        - packages/module-settings/src
        - packages/module-settings/tests
        - packages/nested-set/src
        - packages/nested-set/tests
        - packages/routing/src
        - packages/routing/tests
    tmpDir: .phpstan.cache

    # Without an application to read config/auth.php from, Larastan assumes the framework's own
    # user model, so every `instanceof CmsUser` after `guard()->user()` reads as impossible. The
    # assumption is a PHPDoc type rather than a fact, which is exactly what this setting is for:
    # narrowing still happens, it just stops being reported as always-true or always-false.
    treatPhpDocTypesAsCertain: false

    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # A view a package registers under its own namespace at runtime is a view Larastan
        # cannot find on disk, so the name never becomes a view-string no matter how literal it
        # is written. Both of these are `<package>::<view>` names of views that exist.
        -
            identifier: argument.type
            message: '#expects view-string, string given#'
            paths:
                - packages/module-admin/src/Http/Controllers/ShellController.php
                - packages/module-seo/src/Rendering/Seo.php
