includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - packages/module-admin/src
        - packages/module-admin/tests
        - packages/localization/src
        - packages/localization/tests
        - packages/mcp/src
        - packages/mcp/tests
        - packages/module-auth/src
        - packages/module-auth/tests
        - packages/module-media/src
        - packages/module-media/tests
        - packages/module-settings/src
        - packages/module-settings/tests
        - packages/nested-set/src
        - packages/nested-set/tests
    tmpDir: .phpstan.cache

    # Without an application to read config/auth.php from, Larastan assumes the framework's own
    # user model, so every `instanceof CmsUser` after `guard()->user()` reads as impossible. The
    # assumption is a PHPDoc type rather than a fact, which is exactly what this setting is for:
    # narrowing still happens, it just stops being reported as always-true or always-false.
    treatPhpDocTypesAsCertain: false

    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        -
            identifier: argument.type
            message: '#expects view-string, string given#'
            path: packages/module-admin/src/Http/Controllers/ShellController.php
