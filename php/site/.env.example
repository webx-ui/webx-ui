APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# A real database from the first minute, not sqlite: foreign keys that are only enforced
# elsewhere, a default longer than its own column and the order the packages' migrations sort
# into are all things sqlite accepts and MariaDB refuses. `php artisan webx:setup` fills these
# in and creates the database if it is not there.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit, the way local Laravel environments usually have it. A module that sends mail — the
# inbox answering a visitor, an invitation to the panel — otherwise writes to the log, which
# looks exactly like mail that never arrived.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# What the panel calls itself, in the browser tab and wherever it names the site.
WEBX_ADMIN_TITLE="${APP_NAME}"

# Where the panel answers. Changing it is a deploy, not a setting: the front end is built with
# this path in it.
WEBX_ADMIN_PATH=cms

# A password over the whole site while it is tested on its real domain: everything asks for a
# pair except the panel, its JSON, the MCP server and a block preview under its token. Switched
# on with no pairs it lets nobody in. A password may have a colon in it, not a comma.
# WEBX_SITE_GATE=true
# WEBX_SITE_GATE_USERS="client:a-long-secret,tester:another-one"

VITE_APP_NAME="${APP_NAME}"

# --- Containers ----------------------------------------------------------------------------
# Read by docker-compose.yml, and only there: `docker compose` substitutes out of this same
# file, so the database the application connects to and the database the server creates are
# one answer. Nothing below means anything to a site running without containers.
#
# The bind address decides who can reach the port at all: 127.0.0.1 is a proxy on this same
# machine, which is the usual shape — TLS ends at the proxy, not here. Put a LAN address here
# when the proxy is elsewhere, and 0.0.0.0 only when you mean it.
APP_BIND=127.0.0.1
APP_PORT=8080

# The database server refuses to start without these two, and compose says so rather than
# starting something unprotected. DB_PASSWORD is the one the application uses, above.
DB_ROOT_PASSWORD=

# The first administrator, created on the first boot and nowhere else. Leave them out and the
# panel comes up with nobody able to sign in; `php artisan webx:admin --super` is the way in
# afterwards. Twelve characters minimum.
# WEBX_ADMIN_NAME=Administrator
# WEBX_ADMIN_EMAIL=
# WEBX_ADMIN_PASSWORD=
