# What the build does not need, and what it must not carry.
#
# The two directories at the top cost the most: `vendor` and `node_modules` are installed
# inside the image from the lock files, and copying the host's copies over them is both slow
# and wrong — they were built for another platform.
vendor
node_modules

.git
.github
.idea
.vscode
.cursor
.zed
.codex

# The secrets. The container is handed its environment by compose; a .env baked into an image
# travels wherever the image does — and so do composer's credentials and the Passport keys of
# whichever machine the build ran on.
.env
.env.*
!.env.example
auth.json
storage/*.key

# What the host generated for itself. The provider list in bootstrap/cache is the one the
# host's `composer install` discovered, dev packages included, and the image has none of them:
# the entrypoint's `package:discover` dies on a class that is not there. The same goes for a
# cached config or route list, which carries the host's paths and settings.
bootstrap/cache/*.php
!bootstrap/cache/.gitignore

public/build
public/hot
public/fonts-manifest.dev.json
public/storage
public/themes
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/app/*
storage/pail
database/database.sqlite
*.log

.phpunit.cache
.phpunit.result.cache

CLAUDE.md
AGENTS.md
