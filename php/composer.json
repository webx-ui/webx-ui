{
    "name": "webx-ui/monorepo",
    "description": "Development root for the WebX UI PHP packages. Never published: every package ships from its own split repository.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "webx-ui/localization": "*",
        "webx-ui/mcp": "*",
        "webx-ui/module-admin": "*",
        "webx-ui/module-auth": "*",
        "webx-ui/module-banners": "*",
        "webx-ui/module-blocks": "*",
        "webx-ui/module-blog": "*",
        "webx-ui/module-catalog": "*",
        "webx-ui/module-catalog-brands": "*",
        "webx-ui/module-catalog-labels": "*",
        "webx-ui/module-catalog-manticore": "*",
        "webx-ui/module-catalog-landings": "*",
        "webx-ui/module-catalog-properties": "*",
        "webx-ui/module-catalog-stock": "*",
        "webx-ui/module-events": "*",
        "webx-ui/module-faq": "*",
        "webx-ui/module-inbox": "*",
        "webx-ui/module-media": "*",
        "webx-ui/module-menu": "*",
        "webx-ui/module-pages": "*",
        "webx-ui/module-press": "*",
        "webx-ui/module-recipes": "*",
        "webx-ui/module-reviews": "*",
        "webx-ui/module-seo": "*",
        "webx-ui/module-services": "*",
        "webx-ui/module-settings": "*",
        "webx-ui/module-tariffs": "*",
        "webx-ui/module-team": "*",
        "webx-ui/module-vacancies": "*",
        "webx-ui/nested-set": "*",
        "webx-ui/routing": "*"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/passport": "^13.8",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "//": "Without this the packages take the version of the git branch, and a constraint between two of them cannot be satisfied locally. scripts/sync-php-version.mjs keeps the map in step with php/package.json.",
                "versions": {
                    "webx-ui/localization": "0.55.0",
                    "webx-ui/mcp": "0.55.0",
                    "webx-ui/module-admin": "0.55.0",
                    "webx-ui/module-auth": "0.55.0",
                    "webx-ui/module-banners": "0.55.0",
                    "webx-ui/module-blocks": "0.55.0",
                    "webx-ui/module-blog": "0.55.0",
                    "webx-ui/module-catalog": "0.55.0",
                    "webx-ui/module-catalog-brands": "0.55.0",
                    "webx-ui/module-catalog-labels": "0.55.0",
                    "webx-ui/module-catalog-landings": "0.55.0",
                    "webx-ui/module-catalog-manticore": "0.55.0",
                    "webx-ui/module-catalog-properties": "0.55.0",
                    "webx-ui/module-catalog-stock": "0.55.0",
                    "webx-ui/module-events": "0.55.0",
                    "webx-ui/module-faq": "0.55.0",
                    "webx-ui/module-inbox": "0.55.0",
                    "webx-ui/module-media": "0.55.0",
                    "webx-ui/module-menu": "0.55.0",
                    "webx-ui/module-pages": "0.55.0",
                    "webx-ui/module-press": "0.55.0",
                    "webx-ui/module-recipes": "0.55.0",
                    "webx-ui/module-reviews": "0.55.0",
                    "webx-ui/module-seo": "0.55.0",
                    "webx-ui/module-services": "0.55.0",
                    "webx-ui/module-settings": "0.55.0",
                    "webx-ui/module-tariffs": "0.55.0",
                    "webx-ui/module-team": "0.55.0",
                    "webx-ui/module-vacancies": "0.55.0",
                    "webx-ui/nested-set": "0.55.0",
                    "webx-ui/routing": "0.55.0"
                }
            }
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\Admin\\Tests\\": "packages/module-admin/tests/",
            "WebxUi\\Auth\\Tests\\": "packages/module-auth/tests/",
            "WebxUi\\Banners\\Tests\\": "packages/module-banners/tests/",
            "WebxUi\\Blocks\\Tests\\": "packages/module-blocks/tests/",
            "WebxUi\\Blog\\Tests\\": "packages/module-blog/tests/",
            "WebxUi\\Catalog\\Manticore\\Tests\\": "packages/module-catalog-manticore/tests/",
            "WebxUi\\Catalog\\Tests\\": "packages/module-catalog/tests/",
            "WebxUi\\CatalogBrands\\Tests\\": "packages/module-catalog-brands/tests/",
            "WebxUi\\CatalogLabels\\Tests\\": "packages/module-catalog-labels/tests/",
            "WebxUi\\CatalogLandings\\Tests\\": "packages/module-catalog-landings/tests/",
            "WebxUi\\CatalogProperties\\Tests\\": "packages/module-catalog-properties/tests/",
            "WebxUi\\CatalogStock\\Tests\\": "packages/module-catalog-stock/tests/",
            "WebxUi\\Events\\Tests\\": "packages/module-events/tests/",
            "WebxUi\\Faq\\Tests\\": "packages/module-faq/tests/",
            "WebxUi\\Inbox\\Tests\\": "packages/module-inbox/tests/",
            "WebxUi\\Localization\\Tests\\": "packages/localization/tests/",
            "WebxUi\\Mcp\\Tests\\": "packages/mcp/tests/",
            "WebxUi\\Media\\Tests\\": "packages/module-media/tests/",
            "WebxUi\\Menu\\Tests\\": "packages/module-menu/tests/",
            "WebxUi\\NestedSet\\Tests\\": "packages/nested-set/tests/",
            "WebxUi\\Pages\\Tests\\": "packages/module-pages/tests/",
            "WebxUi\\Press\\Tests\\": "packages/module-press/tests/",
            "WebxUi\\Recipes\\Tests\\": "packages/module-recipes/tests/",
            "WebxUi\\Reviews\\Tests\\": "packages/module-reviews/tests/",
            "WebxUi\\Routing\\Tests\\": "packages/routing/tests/",
            "WebxUi\\Seo\\Tests\\": "packages/module-seo/tests/",
            "WebxUi\\Services\\Tests\\": "packages/module-services/tests/",
            "WebxUi\\Settings\\Tests\\": "packages/module-settings/tests/",
            "WebxUi\\Tariffs\\Tests\\": "packages/module-tariffs/tests/",
            "WebxUi\\Team\\Tests\\": "packages/module-team/tests/",
            "WebxUi\\Vacancies\\Tests\\": "packages/module-vacancies/tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "lint:fix": "pint",
        "analyse": "phpstan analyse"
    }
}
