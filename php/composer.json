{
    "name": "webx-ui/monorepo",
    "description": "Development root for the WebX UI PHP packages. Never published: every package ships from its own split repository.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "webx-ui/admin": "*",
        "webx-ui/mcp": "*",
        "webx-ui/module-auth": "*",
        "webx-ui/nested-set": "*"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "//": "Without this the packages take the version of the git branch, and a constraint between two of them cannot be satisfied locally. scripts/sync-php-version.mjs keeps the map in step with php/package.json.",
                "versions": {
                    "webx-ui/admin": "0.3.1",
                    "webx-ui/mcp": "0.3.1",
                    "webx-ui/module-auth": "0.3.1",
                    "webx-ui/nested-set": "0.3.1"
                }
            }
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\Admin\\Tests\\": "packages/admin/tests/",
            "WebxUi\\Auth\\Tests\\": "packages/module-auth/tests/",
            "WebxUi\\Mcp\\Tests\\": "packages/mcp/tests/",
            "WebxUi\\NestedSet\\Tests\\": "packages/nested-set/tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "lint:fix": "pint",
        "analyse": "phpstan analyse"
    }
}
