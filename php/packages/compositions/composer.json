{
    "name": "webx-ui/compositions",
    "description": "Compound views as trees of nodes with ids: a package gives the tree, modules add their pieces, a theme and the site patch it by id — compiled into plain Blade views, nothing merged on a request.",
    "keywords": ["laravel", "blade", "layout", "theme", "webx-ui"],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "license": "MIT",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/compositions"
    },
    "require": {
        "php": "^8.4",
        "illuminate/console": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\Compositions\\": "src/"
        },
        "files": ["src/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\Compositions\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["WebxUi\\Compositions\\CompositionsServiceProvider"]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
