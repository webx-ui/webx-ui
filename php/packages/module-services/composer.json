{
    "name": "webx-ui/module-services",
    "description": "A catalogue of services for the WebX UI admin panel: services made of blocks, flat categories with pages of their own, addresses from the registry and full SEO.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "webx-ui",
        "laravel",
        "admin",
        "cms",
        "services"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/module-services"
    },
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "webx-ui/localization": "^0.37.0",
        "webx-ui/mcp": "^0.37.0",
        "webx-ui/module-admin": "^0.37.0",
        "webx-ui/module-blocks": "^0.37.0",
        "webx-ui/module-media": "^0.37.0",
        "webx-ui/module-seo": "^0.37.0",
        "webx-ui/routing": "^0.37.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\Services\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\Services\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\Services\\ServicesServiceProvider"
            ]
        },
        "webx": {
            "module": "services",
            "npm": {
                "@webx-ui/module-services": "^0.1.2"
            },
            "panel": {
                "import": "import { services } from '@webx-ui/module-services'",
                "style": "@webx-ui/module-services/style.css",
                "register": "...services()"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
