{
    "name": "webx-ui/module-seo",
    "description": "SEO for the WebX UI admin panel: rules for addresses, redirects, site-wide defaults, and the <head> the public side prints.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "webx-ui",
        "laravel",
        "admin",
        "seo",
        "redirects"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/module-seo"
    },
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "illuminate/view": "^13.0",
        "webx-ui/localization": "^0.35.1",
        "webx-ui/mcp": "^0.35.1",
        "webx-ui/module-admin": "^0.35.1",
        "webx-ui/module-auth": "^0.35.1",
        "webx-ui/module-settings": "^0.35.1",
        "webx-ui/routing": "^0.35.1"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\Seo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\Seo\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\Seo\\SeoServiceProvider"
            ]
        },
        "webx": {
            "module": "seo",
            "npm": {
                "@webx-ui/module-seo": "^0.5.2"
            },
            "panel": {
                "import": "import { seo } from '@webx-ui/module-seo'",
                "style": "@webx-ui/module-seo/style.css",
                "register": "seo()"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
