[
  {
    "op": "add",
    "target": "tabs",
    "node": {
      "id": "seo",
      "type": "wx-tab",
      "label": "trans::webx-seo::screen.tab",
      "children": [
        {
          "id": "seo-card",
          "type": "wx-card",
          "children": [
            {
              "id": "default-og",
              "type": "wx-media",
              "name": "seo.default-og",
              "label": "trans::webx-seo::screen.default-og",
              "help": "trans::webx-seo::screen.default-og-help",
              "slot": "sidebar",
              "props": {
                "aspect": "16/9",
                "accept": "image"
              }
            },
            {
              "id": "title-template",
              "type": "wx-input",
              "name": "seo.title-template",
              "label": "trans::webx-seo::screen.title-template",
              "help": "trans::webx-seo::screen.title-template-help",
              "props": {
                "placeholder": "{title} — {site}"
              }
            },
            {
              "id": "home-crumb",
              "type": "wx-input",
              "name": "seo.home-crumb",
              "label": "trans::webx-seo::screen.home-crumb",
              "help": "trans::webx-seo::screen.home-crumb-help",
              "localized": true
            },
            {
              "id": "robots-txt",
              "type": "wx-textarea",
              "name": "seo.robots-txt",
              "label": "trans::webx-seo::screen.robots-txt",
              "help": "trans::webx-seo::screen.robots-txt-help",
              "props": {
                "rows": 10
              }
            },
            {
              "id": "org-name",
              "type": "wx-input",
              "name": "seo.org-name",
              "label": "trans::webx-seo::screen.org-name",
              "help": "trans::webx-seo::screen.org-name-help",
              "localized": true
            },
            {
              "id": "org-logo",
              "type": "wx-media",
              "name": "seo.org-logo",
              "label": "trans::webx-seo::screen.org-logo",
              "slot": "sidebar",
              "props": {
                "accept": "image"
              }
            },
            {
              "id": "org-socials",
              "type": "wx-repeater",
              "name": "seo.org-socials",
              "label": "trans::webx-seo::screen.org-socials",
              "help": "trans::webx-seo::screen.org-socials-help",
              "children": [
                {
                  "id": "org-social-url",
                  "type": "wx-input",
                  "name": "url",
                  "label": "trans::webx-seo::screen.org-social-url"
                }
              ]
            }
          ]
        },
        {
          "id": "seo-addresses",
          "type": "wx-card",
          "label": "trans::webx-seo::screen.addresses",
          "help": "trans::webx-seo::screen.addresses-help",
          "children": [
            {
              "id": "normalise-host",
              "type": "wx-select",
              "name": "seo.normalise-host",
              "label": "trans::webx-seo::screen.normalise-host",
              "help": "trans::webx-seo::screen.normalise-host-help",
              "props": {
                "clearable": true,
                "placeholder": "trans::webx-seo::screen.normalise-off",
                "options": [
                  {
                    "label": "trans::webx-seo::screen.normalise-host-bare",
                    "value": "bare"
                  },
                  {
                    "label": "trans::webx-seo::screen.normalise-host-www",
                    "value": "www"
                  }
                ]
              }
            },
            {
              "id": "normalise-https",
              "type": "wx-switch",
              "name": "seo.normalise-https",
              "label": "trans::webx-seo::screen.normalise-https",
              "help": "trans::webx-seo::screen.normalise-https-help"
            },
            {
              "id": "normalise-slashes",
              "type": "wx-switch",
              "name": "seo.normalise-slashes",
              "label": "trans::webx-seo::screen.normalise-slashes",
              "help": "trans::webx-seo::screen.normalise-slashes-help"
            },
            {
              "id": "normalise-index",
              "type": "wx-switch",
              "name": "seo.normalise-index",
              "label": "trans::webx-seo::screen.normalise-index",
              "help": "trans::webx-seo::screen.normalise-index-help"
            },
            {
              "id": "normalise-trailing",
              "type": "wx-select",
              "name": "seo.normalise-trailing",
              "label": "trans::webx-seo::screen.normalise-trailing",
              "help": "trans::webx-seo::screen.normalise-trailing-help",
              "props": {
                "clearable": true,
                "placeholder": "trans::webx-seo::screen.normalise-off",
                "options": [
                  {
                    "label": "trans::webx-seo::screen.normalise-trailing-strip",
                    "value": "strip"
                  }
                ]
              }
            },
            {
              "id": "normalise-case",
              "type": "wx-switch",
              "name": "seo.normalise-case",
              "label": "trans::webx-seo::screen.normalise-case",
              "help": "trans::webx-seo::screen.normalise-case-help"
            }
          ]
        }
      ]
    }
  }
]
