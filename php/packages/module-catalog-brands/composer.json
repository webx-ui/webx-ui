{
    "name": "webx-ui/module-catalog-brands",
    "description": "Brands for the WebX UI catalogue: one per product, each with its own page of the catalogue, a logo and a description, a filter, a line on the card, products()->brand() and brands()->featured() in a template.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "webx-ui",
        "laravel",
        "admin",
        "cms",
        "catalog",
        "e-commerce"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/module-catalog-brands"
    },
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "illuminate/view": "^13.0",
        "webx-ui/localization": "^0.54.0",
        "webx-ui/mcp": "^0.54.0",
        "webx-ui/module-admin": "^0.54.0",
        "webx-ui/module-catalog": "^0.54.0",
        "webx-ui/module-media": "^0.54.0",
        "webx-ui/module-seo": "^0.54.0",
        "webx-ui/routing": "^0.54.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\CatalogBrands\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\CatalogBrands\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\CatalogBrands\\BrandsServiceProvider"
            ]
        },
        "webx": {
            "module": "catalog-brands",
            "npm": {
                "@webx-ui/module-catalog-brands": "^0.1.1"
            },
            "panel": {
                "import": "import { catalogBrands } from '@webx-ui/module-catalog-brands'",
                "style": "@webx-ui/module-catalog-brands/style.css",
                "register": "...catalogBrands()"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
