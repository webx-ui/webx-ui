{
    "name": "webx-ui/module-tasks",
    "description": "A queue of work between people and AI agents for the WebX UI admin panel: tasks with a specification and ordered stages, handed out one at a time, reported on, reviewed, and journalled.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "webx-ui",
        "laravel",
        "admin",
        "cms",
        "tasks",
        "agents"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/module-tasks"
    },
    "require": {
        "php": "^8.4",
        "illuminate/bus": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "webx-ui/mcp": "^0.91.0",
        "webx-ui/module-admin": "^0.91.0",
        "webx-ui/module-auth": "^0.91.0",
        "webx-ui/module-settings": "^0.91.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\Tasks\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\Tasks\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\Tasks\\TasksServiceProvider"
            ]
        },
        "webx": {
            "module": "tasks",
            "npm": {
                "@webx-ui/module-tasks": "^0.2.4"
            },
            "panel": {
                "import": "import { tasks } from '@webx-ui/module-tasks'",
                "style": "@webx-ui/module-tasks/style.css",
                "register": "tasks()"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
