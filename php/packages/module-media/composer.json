{
    "name": "webx-ui/module-media",
    "description": "File manager for a WebX UI admin panel: folders, files, uploads and image editing on any Laravel disk.",
    "keywords": [
        "laravel",
        "admin",
        "cms",
        "media",
        "file-manager",
        "webx-ui"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "license": "MIT",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/module-media"
    },
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "intervention/image": "^3.11",
        "webx-ui/module-admin": "^0.27.0",
        "webx-ui/localization": "^0.27.0",
        "webx-ui/mcp": "^0.27.0",
        "webx-ui/module-auth": "^0.27.0",
        "webx-ui/nested-set": "^0.27.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "webx-ui/module-blocks": "^0.27.0"
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\Media\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\Media\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\Media\\MediaServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
