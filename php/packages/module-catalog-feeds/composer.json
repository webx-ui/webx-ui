{
    "name": "webx-ui/module-catalog-feeds",
    "description": "Product feeds for the WebX UI catalogue: files for marketplaces and ad platforms, set up in the panel from a template, built in the queue and served at a permanent address with a key.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "webx-ui",
        "laravel",
        "admin",
        "cms",
        "catalog",
        "e-commerce",
        "feeds"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/module-catalog-feeds"
    },
    "require": {
        "php": "^8.4",
        "ext-libxml": "*",
        "ext-xmlreader": "*",
        "illuminate/bus": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "seld/jsonlint": "^1.11",
        "webx-ui/localization": "^0.93.0",
        "webx-ui/mcp": "^0.93.0",
        "webx-ui/module-admin": "^0.93.0",
        "webx-ui/module-catalog": "^0.93.0",
        "webx-ui/templates": "^0.93.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\CatalogFeeds\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\CatalogFeeds\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\CatalogFeeds\\CatalogFeedsServiceProvider"
            ]
        },
        "webx": {
            "module": "catalog-feeds",
            "npm": {
                "@webx-ui/module-catalog-feeds": "^0.0.0"
            },
            "panel": {
                "import": "import { catalogFeeds } from '@webx-ui/module-catalog-feeds'",
                "style": "@webx-ui/module-catalog-feeds/style.css",
                "register": "...catalogFeeds()"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
