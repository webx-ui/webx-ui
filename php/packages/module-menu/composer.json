{
    "name": "webx-ui/module-menu",
    "description": "Menus for the WebX UI admin panel: one tree per menu, items that point at an entity, a path or nowhere, rendered through a cached helper.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "webx-ui",
        "laravel",
        "admin",
        "cms",
        "menu"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/module-menu"
    },
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "illuminate/view": "^13.0",
        "webx-ui/localization": "^0.40.0",
        "webx-ui/mcp": "^0.40.0",
        "webx-ui/module-admin": "^0.40.0",
        "webx-ui/nested-set": "^0.40.0",
        "webx-ui/routing": "^0.40.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\Menu\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\Menu\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\Menu\\MenuServiceProvider"
            ]
        },
        "webx": {
            "module": "menu",
            "npm": {
                "@webx-ui/module-menu": "^0.1.5"
            },
            "panel": {
                "import": "import { menu } from '@webx-ui/module-menu'",
                "style": "@webx-ui/module-menu/style.css",
                "register": "menu()"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
