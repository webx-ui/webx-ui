{
    "name": "webx-ui/delivery-novaposhta",
    "description": "Nova Poshta for WebX UI delivery: the carrier, its key and sender settings, a thin read-guarded client of its JSON API, and three method types — branch, parcel locker, courier.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "webx-ui",
        "laravel",
        "delivery",
        "shipping",
        "nova-poshta"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/delivery-novaposhta"
    },
    "require": {
        "php": "^8.4",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "webx-ui/localization": "^0.95.0",
        "webx-ui/module-delivery": "^0.95.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\Delivery\\NovaPoshta\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\Delivery\\NovaPoshta\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\Delivery\\NovaPoshta\\DeliveryNovaPoshtaServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
