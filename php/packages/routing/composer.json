{
    "name": "webx-ui/routing",
    "description": "The registry of a site's public addresses: one flat namespace, one row per addressable entity, one resolver that hands a path to whoever owns it.",
    "keywords": [
        "laravel",
        "eloquent",
        "routing",
        "url",
        "slug",
        "seo",
        "webx-ui"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "license": "MIT",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/routing"
    },
    "require": {
        "php": "^8.3",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "webx-ui/localization": "^0.27.0",
        "webx-ui/nested-set": "^0.27.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\Routing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\Routing\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\Routing\\RoutingServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
