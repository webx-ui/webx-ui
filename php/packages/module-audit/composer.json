{
    "name": "webx-ui/module-audit",
    "description": "A site audit for the WebX UI admin panel: the production config, the host's mirrors, slashes and headers, and every address in the database that points at a development stand.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "webx-ui",
        "laravel",
        "admin",
        "cms",
        "seo",
        "audit"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/module-audit"
    },
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.8 || ^8.0",
        "illuminate/bus": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "webx-ui/module-admin": "^0.57.0",
        "webx-ui/module-auth": "^0.57.0",
        "webx-ui/module-settings": "^0.57.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "suggest": {
        "webx-ui/module-pages": "Its pages, drafts included, are searched for addresses of a development stand.",
        "webx-ui/module-blocks": "Its regions, drafts included, are searched for addresses of a development stand."
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\Audit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\Audit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\Audit\\AuditServiceProvider"
            ]
        },
        "webx": {
            "module": "audit",
            "npm": {
                "@webx-ui/module-audit": "^0.1.0"
            },
            "panel": {
                "import": "import { audit } from '@webx-ui/module-audit'",
                "style": "@webx-ui/module-audit/style.css",
                "register": "audit()"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
