{
  "$schema": "https://webx-ui.github.io/webx-ui/schema/screen.json",
  "screen": "users.settings",
  "model": "settings",
  "root": [
    {
      "id": "registration-card",
      "type": "wx-card",
      "label": "trans::webx-users::screen.registration",
      "children": [
        {
          "id": "registration",
          "type": "wx-segmented",
          "name": "users.registration",
          "label": "trans::webx-users::screen.registration-field",
          "help": "trans::webx-users::screen.registration-help",
          "default": "open",
          "props": {
            "options": [
              { "value": "open", "label": "trans::webx-users::screen.registration-open" },
              { "value": "closed", "label": "trans::webx-users::screen.registration-closed" }
            ]
          }
        }
      ]
    },
    {
      "id": "fields-card",
      "type": "wx-card",
      "label": "trans::webx-users::screen.fields",
      "children": [
        {
          "id": "fields-help",
          "type": "wx-alert",
          "props": { "type": "info", "description": "trans::webx-users::screen.fields-help" }
        },
        {
          "id": "require-first-name",
          "type": "wx-segmented",
          "name": "users.fields.first_name",
          "label": "trans::webx-users::screen.first-name",
          "default": "optional",
          "props": {
            "options": [
              { "value": "hidden", "label": "trans::webx-users::screen.requirement-hidden" },
              { "value": "optional", "label": "trans::webx-users::screen.requirement-optional" },
              { "value": "required", "label": "trans::webx-users::screen.requirement-required" }
            ]
          }
        },
        {
          "id": "require-last-name",
          "type": "wx-segmented",
          "name": "users.fields.last_name",
          "label": "trans::webx-users::screen.last-name",
          "default": "optional",
          "props": {
            "options": [
              { "value": "hidden", "label": "trans::webx-users::screen.requirement-hidden" },
              { "value": "optional", "label": "trans::webx-users::screen.requirement-optional" },
              { "value": "required", "label": "trans::webx-users::screen.requirement-required" }
            ]
          }
        },
        {
          "id": "require-phone",
          "type": "wx-segmented",
          "name": "users.fields.phone",
          "label": "trans::webx-users::screen.phone",
          "default": "optional",
          "props": {
            "options": [
              { "value": "hidden", "label": "trans::webx-users::screen.requirement-hidden" },
              { "value": "optional", "label": "trans::webx-users::screen.requirement-optional" },
              { "value": "required", "label": "trans::webx-users::screen.requirement-required" }
            ]
          }
        }
      ]
    }
  ]
}
