{
    "name": "webx-ui/module-catalog-stock",
    "description": "Stock statuses for the WebX UI catalogue: in stock, out of stock, on order — one per product, a line on the card, a filter, the refusal to sell and products()->inStock() in a template.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "webx-ui",
        "laravel",
        "admin",
        "cms",
        "catalog",
        "e-commerce"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/module-catalog-stock"
    },
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "illuminate/view": "^13.0",
        "webx-ui/localization": "^0.61.0",
        "webx-ui/mcp": "^0.61.0",
        "webx-ui/module-admin": "^0.61.0",
        "webx-ui/module-catalog": "^0.61.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\CatalogStock\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\CatalogStock\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\CatalogStock\\StockServiceProvider"
            ]
        },
        "webx": {
            "module": "catalog-stock",
            "npm": {
                "@webx-ui/module-catalog-stock": "^0.1.6"
            },
            "panel": {
                "import": "import { catalogStock } from '@webx-ui/module-catalog-stock'",
                "style": "@webx-ui/module-catalog-stock/style.css",
                "register": "...catalogStock()"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
