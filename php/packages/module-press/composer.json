{
    "name": "webx-ui/module-press",
    "description": "Press for the WebX UI admin panel: the outlets that wrote about the site — a logo, a name, a link — and the articles in them, each leading out to the article or a PDF; a page per outlet, three blocks, and press() in templates.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "webx-ui",
        "laravel",
        "admin",
        "cms",
        "press",
        "media-coverage"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/module-press"
    },
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "webx-ui/localization": "^0.50.0",
        "webx-ui/mcp": "^0.50.0",
        "webx-ui/module-admin": "^0.50.0",
        "webx-ui/module-blocks": "^0.50.0",
        "webx-ui/module-media": "^0.50.0",
        "webx-ui/module-seo": "^0.50.0",
        "webx-ui/routing": "^0.50.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "webx-ui/module-pages": "^0.50.0"
    },
    "suggest": {
        "webx-ui/module-pages": "A page at the prefix with the catalogue block is the site's page of press."
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\Press\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\Press\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\Press\\PressServiceProvider"
            ]
        },
        "webx": {
            "module": "press",
            "npm": {
                "@webx-ui/module-press": "^0.1.2"
            },
            "panel": {
                "import": "import { press } from '@webx-ui/module-press'",
                "style": "@webx-ui/module-press/style.css",
                "register": "press()"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
