{
    "name": "webx-ui/nested-set",
    "description": "Nested set (modified preorder tree traversal) for Eloquent models: ordered trees with cheap subtree reads.",
    "keywords": ["laravel", "eloquent", "nested-set", "tree", "hierarchy", "webx-ui"],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "license": "MIT",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/nested-set"
    },
    "require": {
        "php": "^8.3",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\NestedSet\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\NestedSet\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["WebxUi\\NestedSet\\NestedSetServiceProvider"]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
