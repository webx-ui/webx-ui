{
    "name": "webx-ui/module-auth",
    "description": "Administrators, roles and sign-in for a WebX UI admin panel — kept separate from the site's own users.",
    "keywords": [
        "laravel",
        "admin",
        "cms",
        "authentication",
        "permissions",
        "webx-ui"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "license": "MIT",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/module-auth"
    },
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "laravel/passport": "^13.8",
        "webx-ui/module-admin": "^0.41.0",
        "webx-ui/localization": "^0.41.0",
        "webx-ui/mcp": "^0.41.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\Auth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\Auth\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\Auth\\AuthServiceProvider"
            ]
        },
        "webx": {
            "module": "auth",
            "npm": {
                "@webx-ui/module-auth": "^0.8.7"
            },
            "panel": {
                "import": "import { admins, connect } from '@webx-ui/module-auth'",
                "style": "@webx-ui/module-auth/style.css",
                "register": [
                    "admins()",
                    "connect()"
                ]
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
