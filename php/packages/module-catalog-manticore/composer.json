{
    "name": "webx-ui/module-catalog-manticore",
    "description": "Manticore Search as the engine of the WebX UI catalogue: a table per language with the morphology of every language of the site, facets and counts in one round trip, rebuilds swapped in whole, and the database to fall back on.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "webx-ui",
        "laravel",
        "admin",
        "cms",
        "catalog",
        "e-commerce",
        "manticore",
        "search"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/module-catalog-manticore"
    },
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.8 || ^8.0",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "webx-ui/module-catalog": "^0.59.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "webx-ui/module-catalog-brands": "^0.59.0",
        "webx-ui/module-catalog-labels": "^0.59.0",
        "webx-ui/module-catalog-stock": "^0.59.0"
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\Catalog\\Manticore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\Catalog\\Manticore\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\Catalog\\Manticore\\ManticoreServiceProvider"
            ]
        },
        "webx": {
            "module": "catalog-manticore",
            "npm": {
                "@webx-ui/module-catalog-manticore": "^0.1.2"
            },
            "panel": {
                "import": "import { catalogManticore } from '@webx-ui/module-catalog-manticore'",
                "style": "@webx-ui/module-catalog-manticore/style.css",
                "register": "...catalogManticore()"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
