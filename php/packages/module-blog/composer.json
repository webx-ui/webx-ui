{
    "name": "webx-ui/module-blog",
    "description": "A blog for the WebX UI admin panel: articles made of blocks, rubrics and tags, addresses from the registry, scheduled publication and a feed.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "webx-ui",
        "laravel",
        "admin",
        "cms",
        "blog"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/module-blog"
    },
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "illuminate/view": "^13.0",
        "webx-ui/localization": "^0.43.0",
        "webx-ui/mcp": "^0.43.0",
        "webx-ui/module-admin": "^0.43.0",
        "webx-ui/module-auth": "^0.43.0",
        "webx-ui/module-blocks": "^0.43.0",
        "webx-ui/module-media": "^0.43.0",
        "webx-ui/module-seo": "^0.43.0",
        "webx-ui/routing": "^0.43.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\Blog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\Blog\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\Blog\\BlogServiceProvider"
            ]
        },
        "webx": {
            "module": "blog",
            "npm": {
                "@webx-ui/module-blog": "^0.5.7"
            },
            "panel": {
                "import": "import { blog } from '@webx-ui/module-blog'",
                "style": "@webx-ui/module-blog/style.css",
                "register": "...blog()"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
