{
  "$schema": "https://webx-ui.github.io/webx-ui/schema/screen.json",
  "screen": "blog.author-form",
  "model": "author",
  "root": [
    {
      "id": "tabs",
      "type": "wx-tabs",
      "children": [
        {
          "id": "content",
          "type": "wx-tab",
          "label": "trans::webx-blog::author.tab-profile",
          "children": [
            {
              "id": "naming",
              "type": "wx-card",
              "children": [
                {
                  "id": "title",
                  "type": "wx-input",
                  "name": "title",
                  "label": "trans::webx-blog::author.field-name",
                  "help": "trans::webx-blog::author.field-name-help",
                  "localized": true,
                  "props": {
                    "maxlength": 255
                  }
                },
                {
                  "id": "role",
                  "type": "wx-input",
                  "name": "role",
                  "label": "trans::webx-blog::author.field-role",
                  "localized": true,
                  "props": {
                    "maxlength": 255
                  }
                },
                {
                  "id": "bio",
                  "type": "wx-rich-text",
                  "name": "bio",
                  "label": "trans::webx-blog::author.field-bio",
                  "help": "trans::webx-blog::author.field-bio-help",
                  "localized": true
                }
              ]
            },
            {
              "id": "presentation",
              "type": "wx-card",
              "label": "trans::webx-blog::author.card-page",
              "children": [
                {
                  "id": "photo",
                  "type": "wx-media",
                  "name": "photo",
                  "label": "trans::webx-blog::author.field-photo",
                  "props": {
                    "accept": "image",
                    "captions": false,
                    "aspect": "1/1",
                    "width": 160
                  }
                },
                {
                  "id": "socials",
                  "type": "wx-repeater",
                  "name": "socials",
                  "label": "trans::webx-blog::author.field-socials",
                  "help": "trans::webx-blog::author.field-socials-help",
                  "props": {
                    "sortable": true,
                    "itemLabel": "network",
                    "addLabel": "trans::webx-blog::author.socials-add",
                    "emptyText": "trans::webx-blog::author.socials-empty"
                  },
                  "children": [
                    {
                      "id": "social-network",
                      "type": "wx-select",
                      "name": "network",
                      "label": "trans::webx-blog::author.social-network",
                      "props": {
                        "options": [
                          {
                            "value": "facebook",
                            "label": "Facebook"
                          },
                          {
                            "value": "instagram",
                            "label": "Instagram"
                          },
                          {
                            "value": "x",
                            "label": "X"
                          },
                          {
                            "value": "youtube",
                            "label": "YouTube"
                          },
                          {
                            "value": "tiktok",
                            "label": "TikTok"
                          },
                          {
                            "value": "linkedin",
                            "label": "LinkedIn"
                          },
                          {
                            "value": "threads",
                            "label": "Threads"
                          },
                          {
                            "value": "pinterest",
                            "label": "Pinterest"
                          },
                          {
                            "value": "telegram",
                            "label": "Telegram"
                          },
                          {
                            "value": "whatsapp",
                            "label": "WhatsApp"
                          },
                          {
                            "value": "viber",
                            "label": "Viber"
                          },
                          {
                            "value": "discord",
                            "label": "Discord"
                          },
                          {
                            "value": "reddit",
                            "label": "Reddit"
                          },
                          {
                            "value": "twitch",
                            "label": "Twitch"
                          },
                          {
                            "value": "vimeo",
                            "label": "Vimeo"
                          },
                          {
                            "value": "mastodon",
                            "label": "Mastodon"
                          },
                          {
                            "value": "bluesky",
                            "label": "Bluesky"
                          },
                          {
                            "value": "github",
                            "label": "GitHub"
                          },
                          {
                            "value": "behance",
                            "label": "Behance"
                          },
                          {
                            "value": "dribbble",
                            "label": "Dribbble"
                          },
                          {
                            "value": "medium",
                            "label": "Medium"
                          },
                          {
                            "value": "tripadvisor",
                            "label": "Tripadvisor"
                          },
                          {
                            "value": "vk",
                            "label": "VK"
                          },
                          {
                            "value": "other",
                            "label": "trans::webx-settings::screen.social-other"
                          }
                        ]
                      }
                    },
                    {
                      "id": "social-url",
                      "type": "wx-input",
                      "name": "url",
                      "label": "trans::webx-blog::author.social-url",
                      "props": {
                        "type": "url",
                        "placeholder": "https://"
                      }
                    }
                  ]
                },
                {
                  "id": "is-public",
                  "type": "wx-switch",
                  "name": "is_public",
                  "label": "trans::webx-blog::author.field-public",
                  "help": "trans::webx-blog::author.field-public-help"
                },
                {
                  "id": "slug",
                  "type": "wx-input",
                  "name": "slug",
                  "label": "trans::webx-blog::author.field-slug",
                  "help": "trans::webx-blog::author.field-slug-help",
                  "localized": true,
                  "props": {
                    "maxlength": 200
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "seo",
          "type": "wx-tab",
          "label": "trans::webx-blog::rubric.tab-seo",
          "children": [
            {
              "id": "seo-placeholder",
              "type": "wx-alert",
              "label": "trans::webx-blog::screen.seo-empty",
              "props": {
                "type": "info",
                "variant": "soft"
              }
            }
          ]
        }
      ]
    }
  ]
}
