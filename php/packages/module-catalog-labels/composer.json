{
    "name": "webx-ui/module-catalog-labels",
    "description": "Labels for the WebX UI catalogue: top, sale, new — several per product, a badge on the card, a filter with a multiple choice and products()->label('sale') in a template.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "webx-ui",
        "laravel",
        "admin",
        "cms",
        "catalog",
        "e-commerce"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/module-catalog-labels"
    },
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "illuminate/view": "^13.0",
        "webx-ui/localization": "^0.62.1",
        "webx-ui/mcp": "^0.62.1",
        "webx-ui/module-admin": "^0.62.1",
        "webx-ui/module-catalog": "^0.62.1"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\CatalogLabels\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\CatalogLabels\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\CatalogLabels\\LabelsServiceProvider"
            ]
        },
        "webx": {
            "module": "catalog-labels",
            "npm": {
                "@webx-ui/module-catalog-labels": "^0.1.6"
            },
            "panel": {
                "import": "import { catalogLabels } from '@webx-ui/module-catalog-labels'",
                "style": "@webx-ui/module-catalog-labels/style.css",
                "register": "...catalogLabels()"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
