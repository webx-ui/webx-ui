<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="bootstrap.php" colors="false" failOnWarning="true" failOnRisky="true" failOnIncomplete="true" cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Modules">
            <directory>modules/*/tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing"/>
    </php>
</phpunit>
