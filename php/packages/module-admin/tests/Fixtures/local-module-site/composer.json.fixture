{
    "name": "example/site",
    "type": "project",
    "require": {
        "php": "^8.4",
        "webx-ui/module-admin": "^0.94.0",
        "webx-ui/module-auth": "^0.94.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
