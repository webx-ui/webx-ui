<script setup lang="ts">
import { computed, onBeforeUnmount, ref, watch } from 'vue'
import { useRouter } from 'vue-router'
import { confirm, toast, WxEmpty, WxInput, WxSortableList, WxText } from '@webx-ui/core'
import {
  useAdmin,
  useErrorText,
  useTranslate,
  WxListScreen,
  WxRowMenu,
  type RowAction,
  type ScreenAction,
} from '@webx-ui/module-admin'
import { create{{ Studly }}Api } from './api'
import { use{{ Studly }}Messages } from './i18n'
import type { {{ Model }}Row } from './types'

/**
 * The list of {{ models }}, in its one order: a drag moves it, a row opens its form. A search
 * shows a selection, so the drag goes away until it is cleared.
 */
const props = withDefaults(defineProps<{ base?: string }>(), { base: '/{{ id }}' })

const admin = useAdmin()
const api = create{{ Studly }}Api(admin)
const router = useRouter()
use{{ Studly }}Messages()

const t = useTranslate('webx-{{ id }}')
/* Not the server's `message`: the panel says how a request failed in its own words. */
const message = useErrorText()

const rows = ref<{{ Model }}Row[]>([])
const loading = ref(true)
const search = ref('')

const canManage = computed(() => admin.can('{{ id }}.manage'))
const sortable = computed(() => canManage.value && search.value.trim() === '')

const title = computed(
  () => admin.state.manifest?.modules.find((module) => module.id === '{{ id }}')?.title ?? t('module.title'),
)

async function load(): Promise<void> {
  loading.value = true

  try {
    rows.value = await api.list(search.value.trim())
  } catch (error) {
    toast.danger(message(error))
  } finally {
    loading.value = false
  }
}

void load()

let pause: ReturnType<typeof setTimeout> | undefined

watch(search, () => {
  clearTimeout(pause)
  pause = setTimeout(() => void load(), 300)
})

onBeforeUnmount(() => clearTimeout(pause))

function open(row: {{ Model }}Row | null): void {
  void router.push(`${props.base}/${row === null ? 'new' : row.id}`)
}

/**
 * The order on screen, written as a whole. The list is already in its new order, so a failure
 * has to put it back rather than leave the screen disagreeing with the database.
 */
async function reorder(): Promise<void> {
  try {
    await api.reorder(rows.value.map((row) => row.id))
  } catch (error) {
    toast.danger(message(error, t('list.reorder-failed')))
    await load()
  }
}

async function remove(row: {{ Model }}Row): Promise<void> {
  const agreed = await confirm({
    title: t('list.delete-title', { name: row.title }),
    message: t('list.delete-text'),
    confirmText: t('list.delete'),
    cancelText: t('list.cancel'),
    tone: 'danger',
  })

  if (!agreed) return

  try {
    await api.remove(row.id)
    toast.success(t('list.deleted'))
    await load()
  } catch (error) {
    toast.danger(message(error))
  }
}

function actionsFor(row: {{ Model }}Row): RowAction[] {
  return [
    { key: 'open', icon: 'edit', label: t('list.open'), run: () => open(row) },
    ...(canManage.value
      ? [{ key: 'delete', icon: 'trash' as const, label: t('list.delete'), danger: true, run: () => void remove(row) }]
      : []),
  ]
}

/* What the section offers. Declared, because on a phone the head folds it into the ···. */
const actions = computed<ScreenAction[]>(() =>
  canManage.value
    ? [{ key: 'new', label: t('list.new'), icon: 'plus', primary: true, run: () => open(null) }]
    : [],
)
</script>

<template>
  <wx-list-screen :title="title" :actions="actions">
    <div class="{{ id }}-list">
      <wx-input v-model="search" :placeholder="t('list.search')" :aria-label="t('list.search')" clearable />

      <wx-empty v-if="!loading && rows.length === 0" :title="search === '' ? t('list.empty') : t('list.empty-search')" />

      <template v-else>
        <wx-sortable-list
          v-model="rows"
          plain
          item-key="id"
          :item-label="(row: {{ Model }}Row) => row.title"
          :drag-label="t('list.reorder')"
          :disabled="!sortable"
          :aria-label="title"
          @move="reorder"
        >
          <template #default="{ item }">
            <button type="button" class="{{ id }}-list__title" @click="open(item)">
              {{ item.title }}
            </button>
          </template>

          <template #actions="{ item }">
            <wx-row-menu :actions="actionsFor(item)" :label="item.title" />
          </template>
        </wx-sortable-list>

        <wx-text v-if="canManage" size="sm" tone="muted">
          {{ sortable ? t('list.order') : t('list.order-search') }}
        </wx-text>
      </template>
    </div>
  </wx-list-screen>
</template>

<style scoped>
.{{ id }}-list {
  display: flex;
  flex-direction: column;
  gap: var(--wx-gap, var(--wx-space-12));
}

.{{ id }}-list__title {
  flex: 1 1 auto;
  min-width: 0;
  padding: 0;
  border: 0;
  background: none;
  color: inherit;
  font: inherit;
  text-align: start;
  cursor: pointer;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
</style>
