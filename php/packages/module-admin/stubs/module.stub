<?php

declare(strict_types=1);

namespace {{ namespace }};

use WebxUi\Admin\AbstractModule;
use WebxUi\Admin\Contracts\ProvidesDemo;
use WebxUi\Admin\Demo\DemoLedger;

class {{ class }} extends AbstractModule implements ProvidesDemo
{
    public function id(): string
    {
        return '{{ id }}';
    }

    public function title(): string
    {
        return '{{ title }}';
    }

    /**
     * Everything the module checks, and nothing else: a role can only hold what is declared here.
     * Reading routes and tools ask for `view` or `manage`, writing ones for `manage` — add an
     * action of its own (`{{ id }}.delete`, `{{ id }}.export`) only where somebody would want it
     * without the rest. Guide: https://webx-ui.github.io/webx-ui/guide/permissions
     *
     * @return list<string>
     */
    public function permissions(): array
    {
        return [
            '{{ id }}.view',
            '{{ id }}.manage',
        ];
    }

    /**
     * @return array<string, mixed>
     */
    public function manifest(): array
    {
        return [];
    }

    /**
     * Modules this one has nothing to seed without — they are the order too.
     *
     * @return list<string>
     */
    public function requires(): array
    {
        return [];
    }

    /**
     * Something to look at on a site nobody has written into yet; `webx:demo` runs it.
     *
     * Fixtures go in resources/demo/{{ id }}, and everything created has to be written down —
     * `webx:demo --remove` plays the journal backwards and knows nothing else about it:
     *
     *     $record = Thing::query()->create([...]);
     *     $ledger->created($record);
     */
    public function seed(DemoLedger $ledger): void
    {
        //
    }
}
