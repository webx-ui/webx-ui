import { createAdmin } from '@webx-ui/module-admin'
// webx:imports
// /webx:imports

// The components carry no styles of their own: each package ships one stylesheet, and the
// design tokens travel inside the core one.
import '@webx-ui/core/style.css'
import '@webx-ui/module-admin/style.css'
// webx:styles
// /webx:styles
// Optional — without it the panel renders in the platform's own UI font.
import '@webx-ui/tokens/fonts.css'

/**
 * The panel.
 *
 * `php artisan webx:panel --sync` fills the three marked regions from the packages installed on
 * the server, so a module appears here the moment both halves are in place. Everything outside
 * those markers is yours — it is read by nobody and rewritten by nothing.
 */
createAdmin({
  basePath: '{{ path }}',
  modules: [
    // webx:modules
    // /webx:modules
  ],
}).mount()
