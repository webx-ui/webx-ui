{
    "name": "webx-ui/module-admin",
    "description": "The frame a WebX UI admin panel is built on: a module contract, the manifest the front end reads, and the routes that serve it.",
    "keywords": [
        "laravel",
        "admin",
        "cms",
        "modules",
        "webx-ui"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "license": "MIT",
    "replace": {
        "webx-ui/admin": "self.version"
    },
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/module-admin"
    },
    "require": {
        "php": "^8.3",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "laravel/prompts": "^0.3.11",
        "symfony/process": "^7.4 || ^8.0",
        "webx-ui/localization": "^0.31.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\Admin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\Admin\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\Admin\\AdminServiceProvider"
            ]
        },
        "webx": {
            "module": "admin",
            "npm": {
                "@webx-ui/core": "^0.32.0",
                "@webx-ui/module-admin": "^0.14.1",
                "@webx-ui/tokens": "^0.4.0",
                "vue": "^3.5.0",
                "vue-router": "^4.5.0"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
