{
  "defaults": {
    "color-bg": "#ffffff",
    "color-surface": "#f6f7f9",
    "color-surface-muted": "#eceef2",
    "color-text": "#1d2127",
    "color-text-muted": "#555e6b",
    "color-border": "#dde1e6",
    "color-accent": "#1f5fbf",
    "color-accent-contrast": "#ffffff",
    "color-accent-2": "#0e7a6b",
    "color-highlight": "#fff3c4",
    "color-danger": "#b42318",
    "color-success": "#1a7f37",

    "font-body": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "font-heading": "var(--site-font-body)",
    "font-size-base": "1rem",
    "line-height-base": "1.6",
    "font-size-1": "clamp(2rem, 1.4rem + 2.4vw, 3rem)",
    "font-size-2": "clamp(1.625rem, 1.25rem + 1.5vw, 2.25rem)",
    "font-size-3": "clamp(1.375rem, 1.2rem + 0.7vw, 1.75rem)",
    "font-size-4": "1.25rem",
    "font-size-5": "1.125rem",
    "font-size-6": "1rem",

    "space-1": "0.25rem",
    "space-2": "0.5rem",
    "space-3": "0.75rem",
    "space-4": "1rem",
    "space-5": "1.5rem",
    "space-6": "2rem",
    "space-7": "3rem",
    "space-8": "4rem",
    "radius-sm": "4px",
    "radius-md": "8px",
    "radius-lg": "16px",
    "radius-full": "9999px",

    "shadow-sm": "0 1px 2px rgb(16 24 40 / 0.06), 0 1px 3px rgb(16 24 40 / 0.1)",
    "shadow-md": "0 4px 8px -2px rgb(16 24 40 / 0.1), 0 2px 4px -2px rgb(16 24 40 / 0.06)",

    "container-width": "72rem",
    "gutter": "clamp(1rem, 0.5rem + 2vw, 2rem)",

    "duration": "160ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "presets": {
    "warm": {
      "title": "Warm",
      "tokens": {
        "color-bg": "#fffdf9",
        "color-surface": "#f8f3ec",
        "color-surface-muted": "#efe7dc",
        "color-text": "#2a211b",
        "color-text-muted": "#655a50",
        "color-border": "#e6dccf",
        "color-accent": "#a4461f",
        "color-accent-2": "#6b7f2a",
        "color-highlight": "#fde7c8"
      }
    },
    "night": {
      "title": "Night",
      "tokens": {
        "color-bg": "#111418",
        "color-surface": "#1a1f25",
        "color-surface-muted": "#232a32",
        "color-text": "#e8eaed",
        "color-text-muted": "#a3acb8",
        "color-border": "#2e3640",
        "color-accent": "#7fb0ff",
        "color-accent-contrast": "#0b1220",
        "color-accent-2": "#5fd3c0",
        "color-highlight": "#3d3412",
        "color-danger": "#ff8a80",
        "color-success": "#6fd08c",
        "shadow-sm": "0 1px 2px rgb(0 0 0 / 0.4)",
        "shadow-md": "0 4px 12px -2px rgb(0 0 0 / 0.5)"
      }
    }
  }
}
