{
    "name": "webx-ui/theme-default",
    "description": "The theme every new WebX UI site stands on: a value for every site token, the page shell and the typography of prose — a neutral starting point, written to be overridden.",
    "type": "webx-theme",
    "keywords": [
        "laravel",
        "blade",
        "theme",
        "design-tokens",
        "webx-ui"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "license": "MIT",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/theme-default"
    },
    "require": {
        "php": "^8.4",
        "webx-ui/themes": "^0.72.0",
        "webx-ui/widgets": "^0.72.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\ThemeDefault\\Tests\\": "tests/"
        }
    },
    "extra": {
        "webx": {
            "theme": {
                "title": "Default",
                "uses": [],
                "requires": [
                    "module-pages",
                    "module-blocks",
                    "module-seo"
                ],
                "locales": [
                    "en",
                    "ru",
                    "uk",
                    "de",
                    "fr",
                    "es",
                    "it",
                    "pl",
                    "pt",
                    "tr"
                ],
                "fonts": [
                    {
                        "family": "Inter",
                        "weight": "100 900",
                        "style": "normal",
                        "files": {
                            "latin": "fonts/inter-latin.woff2",
                            "latin-ext": "fonts/inter-latin-ext.woff2",
                            "cyrillic": "fonts/inter-cyrillic.woff2"
                        }
                    },
                    {
                        "family": "Inter",
                        "weight": "100 900",
                        "style": "italic",
                        "files": {
                            "latin": "fonts/inter-latin-italic.woff2",
                            "latin-ext": "fonts/inter-latin-ext-italic.woff2",
                            "cyrillic": "fonts/inter-cyrillic-italic.woff2"
                        }
                    }
                ]
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
