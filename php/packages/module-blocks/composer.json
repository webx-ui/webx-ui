{
    "name": "webx-ui/module-blocks",
    "description": "The block constructor for the WebX UI admin panel: block types made entirely in the panel — fields, Blade, CSS, script — and the renderer that prints an entity's content from them.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "webx-ui",
        "laravel",
        "admin",
        "blocks",
        "page-builder",
        "blade"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/module-blocks"
    },
    "require": {
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "illuminate/view": "^13.0",
        "php": "^8.3",
        "webx-ui/localization": "^0.32.1",
        "webx-ui/mcp": "^0.32.1",
        "webx-ui/module-admin": "^0.32.1",
        "webx-ui/module-auth": "^0.32.1",
        "webx-ui/routing": "^0.32.1"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\Blocks\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\Blocks\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\Blocks\\BlocksServiceProvider"
            ]
        },
        "webx": {
            "module": "blocks",
            "npm": {
                "@webx-ui/module-blocks": "^0.8.2"
            },
            "panel": {
                "import": "import { blocks } from '@webx-ui/module-blocks'",
                "style": "@webx-ui/module-blocks/style.css",
                "register": "blocks()"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
