{
  "$schema": "https://webx-ui.github.io/webx-ui/schema/screen.json",
  "screen": "settings.index",
  "model": "settings",
  "root": [
    {
      "id": "tabs",
      "type": "wx-tabs",
      "children": [
        {
          "id": "general",
          "type": "wx-tab",
          "label": "trans::webx-settings::screen.general",
          "children": [
            {
              "id": "general-card",
              "type": "wx-card",
              "children": [
                {
                  "id": "project-name",
                  "type": "wx-input",
                  "name": "general.project-name",
                  "label": "trans::webx-settings::screen.project-name",
                  "help": "trans::webx-settings::screen.project-name-help",
                  "localized": true
                }
              ]
            }
          ]
        },
        {
          "id": "branding",
          "type": "wx-tab",
          "label": "trans::webx-settings::screen.branding",
          "children": [
            {
              "id": "branding-card",
              "type": "wx-card",
              "children": [
                {
                  "id": "logo",
                  "type": "wx-media",
                  "name": "branding.logo",
                  "label": "trans::webx-settings::screen.logo",
                  "help": "trans::webx-settings::screen.logo-help",
                  "slot": "sidebar",
                  "props": { "accept": "image" }
                },
                {
                  "id": "mark",
                  "type": "wx-media",
                  "name": "branding.mark",
                  "label": "trans::webx-settings::screen.mark",
                  "help": "trans::webx-settings::screen.mark-help",
                  "slot": "sidebar",
                  "props": { "aspect": "1/1", "accept": "image" }
                }
              ]
            }
          ]
        },
        {
          "id": "shortcodes",
          "type": "wx-tab",
          "label": "trans::webx-settings::screen.shortcodes",
          "children": [
            {
              "id": "shortcodes-card",
              "type": "wx-card",
              "children": [
                {
                  "id": "shortcodes-data",
                  "type": "wx-repeater",
                  "name": "shortcodes.data",
                  "label": "trans::webx-settings::screen.shortcodes",
                  "help": "trans::webx-settings::screen.shortcodes-help",
                  "props": {
                    "sortable": true,
                    "itemLabel": "name",
                    "addLabel": "trans::webx-settings::screen.shortcodes-add",
                    "emptyText": "trans::webx-settings::screen.shortcodes-empty"
                  },
                  "children": [
                    {
                      "id": "shortcode-name",
                      "type": "wx-input",
                      "name": "name",
                      "label": "trans::webx-settings::screen.shortcode-name",
                      "help": "trans::webx-settings::screen.shortcode-name-help",
                      "props": {
                        "maxlength": 64
                      }
                    },
                    {
                      "id": "shortcode-key",
                      "type": "wx-input",
                      "name": "key",
                      "label": "trans::webx-settings::screen.shortcode-key",
                      "help": "trans::webx-settings::screen.shortcode-key-help",
                      "props": {
                        "maxlength": 120
                      }
                    },
                    {
                      "id": "shortcode-value",
                      "type": "wx-input",
                      "name": "value",
                      "label": "trans::webx-settings::screen.shortcode-value",
                      "help": "trans::webx-settings::screen.shortcode-value-help",
                      "localized": true,
                      "props": {
                        "maxlength": 500
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
