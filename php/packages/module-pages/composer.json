{
    "name": "webx-ui/module-pages",
    "description": "Pages for the WebX UI admin panel: a tree of pages with addresses from the registry, content made of blocks, drafts and a history.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "webx-ui",
        "laravel",
        "admin",
        "cms",
        "pages"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/module-pages"
    },
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "illuminate/view": "^13.0",
        "webx-ui/localization": "^0.19.0",
        "webx-ui/mcp": "^0.19.0",
        "webx-ui/module-admin": "^0.19.0",
        "webx-ui/module-auth": "^0.19.0",
        "webx-ui/module-blocks": "^0.19.0",
        "webx-ui/module-seo": "^0.19.0",
        "webx-ui/nested-set": "^0.19.0",
        "webx-ui/routing": "^0.19.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\Pages\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\Pages\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\Pages\\PagesServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
