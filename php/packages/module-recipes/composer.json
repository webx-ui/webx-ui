{
    "name": "webx-ui/module-recipes",
    "description": "Recipes for the WebX UI admin panel: a page of fixed structure per recipe, flat categories with pages of their own, what a recipe is rich in, related services and recipes, schema.org Recipe and a catalogue block.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "webx-ui",
        "laravel",
        "admin",
        "cms",
        "recipes"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/module-recipes"
    },
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "webx-ui/localization": "^0.42.0",
        "webx-ui/mcp": "^0.42.0",
        "webx-ui/module-admin": "^0.42.0",
        "webx-ui/module-media": "^0.42.0",
        "webx-ui/module-seo": "^0.42.0",
        "webx-ui/routing": "^0.42.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "webx-ui/module-blocks": "^0.42.0",
        "webx-ui/module-pages": "^0.42.0",
        "webx-ui/module-services": "^0.42.0"
    },
    "suggest": {
        "webx-ui/module-blocks": "The recipes block — a showcase or the whole catalogue on any page — and the preview of a draft.",
        "webx-ui/module-services": "The Services field on a recipe, and the services printed on its page.",
        "webx-ui/module-pages": "A page at the prefix, made of blocks, in place of the index."
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\Recipes\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\Recipes\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\Recipes\\RecipesServiceProvider"
            ]
        },
        "webx": {
            "module": "recipes",
            "npm": {
                "@webx-ui/module-recipes": "^0.1.1"
            },
            "panel": {
                "import": "import { recipes } from '@webx-ui/module-recipes'",
                "style": "@webx-ui/module-recipes/style.css",
                "register": "...recipes()"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
