{
    "name": "webx-ui/module-team",
    "description": "The team for the WebX UI admin panel: people with a photo, a name, a job title, a short text and their social links, shown on any page as a block — a grid, a slider or a list — and in templates through team().",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "webx-ui",
        "laravel",
        "admin",
        "cms",
        "team",
        "staff"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/module-team"
    },
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "webx-ui/localization": "^0.51.0",
        "webx-ui/mcp": "^0.51.0",
        "webx-ui/module-admin": "^0.51.0",
        "webx-ui/module-blocks": "^0.51.0",
        "webx-ui/module-media": "^0.51.0",
        "webx-ui/routing": "^0.51.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "webx-ui/module-pages": "^0.51.0",
        "webx-ui/module-services": "^0.51.0"
    },
    "suggest": {
        "webx-ui/module-pages": "A page with a team block is the site's page of the team.",
        "webx-ui/module-services": "A person can be linked to the services they provide, and a service's page can show who does it."
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\Team\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\Team\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\Team\\TeamServiceProvider"
            ]
        },
        "webx": {
            "module": "team",
            "npm": {
                "@webx-ui/module-team": "^0.1.2"
            },
            "panel": {
                "import": "import { team } from '@webx-ui/module-team'",
                "style": "@webx-ui/module-team/style.css",
                "register": "team()"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
