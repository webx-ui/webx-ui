{
    "name": "webx-ui/payment-liqpay",
    "description": "LiqPay for WebX UI payments: the gateway, its keys and settings, and one method type — the hosted page of LiqPay with the choice of what it offers.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "webx-ui",
        "laravel",
        "payments",
        "gateway",
        "liqpay"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/payment-liqpay"
    },
    "require": {
        "php": "^8.4",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "webx-ui/localization": "^0.92.0",
        "webx-ui/module-payments": "^0.92.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\Payment\\LiqPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\Payment\\LiqPay\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\Payment\\LiqPay\\PaymentLiqPayServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
