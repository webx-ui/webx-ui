{
    "name": "webx-ui/module-catalog-properties",
    "description": "Properties of products for the WebX UI catalogue: reference books, numbers, texts and yes/no, sets inherited down the categories, facets from the database picked by coverage, merging of values and an index document.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "webx-ui",
        "laravel",
        "admin",
        "cms",
        "catalog",
        "e-commerce"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/module-catalog-properties"
    },
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "webx-ui/localization": "^0.59.0",
        "webx-ui/module-admin": "^0.59.0",
        "webx-ui/module-catalog": "^0.59.0",
        "webx-ui/mcp": "^0.59.0",
        "webx-ui/module-media": "^0.59.0",
        "webx-ui/nested-set": "^0.59.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "webx-ui/module-catalog-brands": "^0.59.0",
        "webx-ui/module-catalog-labels": "^0.59.0",
        "webx-ui/module-catalog-stock": "^0.59.0"
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\CatalogProperties\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\CatalogProperties\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\CatalogProperties\\CatalogPropertiesServiceProvider"
            ]
        },
        "webx": {
            "module": "catalog-properties",
            "npm": {
                "@webx-ui/module-catalog-properties": "^0.1.4"
            },
            "panel": {
                "import": "import { catalogProperties } from '@webx-ui/module-catalog-properties'",
                "style": "@webx-ui/module-catalog-properties/style.css",
                "register": "...catalogProperties()"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
