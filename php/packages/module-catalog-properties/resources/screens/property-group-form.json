{
  "$schema": "https://webx-ui.github.io/webx-ui/schema/screen.json",
  "screen": "catalog.property-group-form",
  "model": "catalog.property-group",
  "root": [
    {
      "id": "naming",
      "type": "wx-card",
      "children": [
        {
          "id": "title",
          "type": "wx-input",
          "name": "title",
          "label": "trans::webx-catalog-properties::group.title",
          "localized": true,
          "props": { "maxlength": 255 }
        },
        {
          "id": "is-visible",
          "type": "wx-switch",
          "name": "is_visible",
          "label": "trans::webx-catalog-properties::group.is_visible",
          "help": "trans::webx-catalog-properties::group.visible-help"
        }
      ]
    },
    {
      "id": "project-fields",
      "type": "wx-card",
      "label": "trans::webx-admin::screens.project-fields",
      "children": []
    }
  ]
}
