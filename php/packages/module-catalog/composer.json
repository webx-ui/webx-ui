{
    "name": "webx-ui/module-catalog",
    "description": "A product catalogue for the WebX UI admin panel: products, a tree of categories, prices, a gallery and the registries its satellite modules plug into.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "webx-ui",
        "laravel",
        "admin",
        "cms",
        "catalog",
        "e-commerce"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/module-catalog"
    },
    "require": {
        "php": "^8.4",
        "illuminate/auth": "^13.0",
        "illuminate/bus": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "illuminate/view": "^13.0",
        "openspout/openspout": "^4.32",
        "webx-ui/localization": "^0.65.0",
        "webx-ui/mcp": "^0.65.0",
        "webx-ui/module-admin": "^0.65.0",
        "webx-ui/module-media": "^0.65.0",
        "webx-ui/module-seo": "^0.65.0",
        "webx-ui/nested-set": "^0.65.0",
        "webx-ui/routing": "^0.65.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "webx-ui/module-audit": "^0.65.0"
    },
    "suggest": {
        "webx-ui/module-audit": "The site audit reports published categories without a description and published products without a picture or a price."
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\Catalog\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\Catalog\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\Catalog\\CatalogServiceProvider"
            ]
        },
        "webx": {
            "module": "catalog",
            "npm": {
                "@webx-ui/module-catalog": "^0.8.4"
            },
            "panel": {
                "import": "import { catalog } from '@webx-ui/module-catalog'",
                "style": "@webx-ui/module-catalog/style.css",
                "register": "...catalog()"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
