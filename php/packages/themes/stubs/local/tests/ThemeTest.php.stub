<?php

namespace Tests\Theme;

use Tests\TestCase;
use WebxUi\Themes\Testing\ThemeContract;
use WebxUi\Themes\ThemeChain;

/**
 * The site's own theme, held to the contract of every theme (WebX UI THEMES §18): the chain
 * builds, every token has a value, `webx:theme:check` finds nothing, text reads in every preset,
 * the layout keeps what a page needs and the theme's views compile.
 *
 * Green from the first day. The first red line is the first rule a change broke — the message
 * says which, and `php artisan webx:theme:check` says the same with the file and the line.
 */
class ThemeTest extends TestCase
{
    use ThemeContract;

    protected function themePath(): string
    {
        return dirname(__DIR__);
    }

    public function test_the_site_stands_on_this_theme(): void
    {
        $top = $this->app->make(ThemeChain::class)->layers[0] ?? null;

        $this->assertNotNull($top, 'WEBX_THEME is empty: the site has no theme.');
        $this->assertTrue($top->local);
        $this->assertSame(realpath(dirname(__DIR__)), realpath($top->path));
    }
}
