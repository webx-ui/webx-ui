{
    "name": "webx-ui/module-payments",
    "description": "Payments for a WebX UI shop: the methods of the site, the attempts to pay an order, and the journal of every exchange with a payment gateway — raw bodies as sent and received, the shop's keys masked, append-only.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "webx-ui",
        "laravel",
        "cms",
        "payments",
        "payment-gateway",
        "commerce"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/module-payments"
    },
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.8 || ^8.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "psr/http-client": "^1.0",
        "webx-ui/module-orders": "^0.91.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "webx-ui/module-admin": "^0.91.0"
    },
    "suggest": {
        "webx-ui/module-admin": "The size of the gateway exchange journal in `webx:doctor`."
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\Payments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\Payments\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\Payments\\PaymentsServiceProvider"
            ]
        },
        "webx": {
            "module": "payments"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
