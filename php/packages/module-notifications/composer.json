{
    "name": "webx-ui/module-notifications",
    "description": "Notification channels for the WebX UI admin panel: Telegram and e-mail, message templates in every language of the site, sending through the queue with retries, and a log of every delivery.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "webx-ui",
        "laravel",
        "admin",
        "cms",
        "notifications",
        "telegram"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/module-notifications"
    },
    "require": {
        "php": "^8.4",
        "illuminate/bus": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/mail": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "mustache/mustache": "^3.2",
        "webx-ui/localization": "^0.75.0",
        "webx-ui/mcp": "^0.75.0",
        "webx-ui/module-admin": "^0.75.0",
        "webx-ui/module-auth": "^0.75.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\Notifications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\Notifications\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\Notifications\\NotificationsServiceProvider"
            ]
        },
        "webx": {
            "module": "notifications"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
