{
    "name": "webx-ui/module-catalog-collections",
    "description": "Product collections of the WebX UI catalogue: a named block of products a manager puts together once, by hand or by a filter, for the site to print wherever it is placed.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "webx-ui",
        "laravel",
        "admin",
        "cms",
        "catalog",
        "e-commerce"
    ],
    "homepage": "https://github.com/webx-ui/webx-ui",
    "authors": [
        {
            "name": "WebX UI",
            "homepage": "https://github.com/webx-ui"
        }
    ],
    "support": {
        "issues": "https://github.com/webx-ui/webx-ui/issues",
        "source": "https://github.com/webx-ui/webx-ui/tree/main/php/packages/module-catalog-collections"
    },
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "illuminate/view": "^13.0",
        "webx-ui/cache": "^0.95.1",
        "webx-ui/localization": "^0.95.1",
        "webx-ui/mcp": "^0.95.1",
        "webx-ui/module-admin": "^0.95.1",
        "webx-ui/module-catalog": "^0.95.1",
        "webx-ui/widgets": "^0.95.1"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "webx-ui/module-blocks": "^0.95.1",
        "webx-ui/module-blog": "^0.95.1",
        "webx-ui/module-pages": "^0.95.1",
        "webx-ui/themes": "^0.95.1"
    },
    "suggest": {
        "webx-ui/module-blocks": "The offered block `product-collection`: a collection put on any page or region from the panel.",
        "webx-ui/module-blog": "The demo puts a collection in the text of an article.",
        "webx-ui/module-pages": "The demo puts collections on the home page.",
        "webx-ui/themes": "With a theme, a collection gets its base look on site tokens (resources/theme/catalog-collections.css)."
    },
    "autoload": {
        "psr-4": {
            "WebxUi\\CatalogCollections\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebxUi\\CatalogCollections\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebxUi\\CatalogCollections\\CatalogCollectionsServiceProvider"
            ]
        },
        "webx": {
            "module": "catalog-collections",
            "npm": {
                "@webx-ui/module-catalog-collections": "^0.2.0"
            },
            "panel": {
                "import": "import { catalogCollections } from '@webx-ui/module-catalog-collections'",
                "style": "@webx-ui/module-catalog-collections/style.css",
                "register": "...catalogCollections()"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
