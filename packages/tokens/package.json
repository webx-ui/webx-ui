{
  "name": "@webx-ui/tokens",
  "version": "0.2.0",
  "description": "Design tokens for WebX UI — colors, spacing, typography, radii, shadows.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "webx-ui",
    "design-tokens",
    "css-variables"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webx-ui/webx-ui.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://webx-ui.github.io/webx-ui/tokens/",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./dist/tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "pnpm generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0"
  }
}
