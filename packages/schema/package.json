{
  "name": "@webx-ui/schema",
  "version": "0.3.0",
  "description": "Screens as JSON for WebX UI admin panels: the node format, patches, the type registry and the renderer.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "webx-ui",
    "vue",
    "json-schema",
    "renderer",
    "admin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webx-ui/webx-ui.git",
    "directory": "packages/schema"
  },
  "homepage": "https://webx-ui.github.io/webx-ui/guide/screens.html",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./schemas/screen.json": "./schemas/screen.schema.json",
    "./schemas/patch.json": "./schemas/patch.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@webx-ui/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.14",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.24",
    "vue-tsc": "^3.1.3"
  }
}
