{
  "name": "@webx-ui/module-auth",
  "version": "0.1.0",
  "description": "Signing in to a WebX UI admin panel: the screen, the session and the router guard. Pairs with webx-ui/module-auth on the server.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "webx-ui",
    "vue",
    "vue3",
    "admin",
    "authentication",
    "laravel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webx-ui/webx-ui.git",
    "directory": "packages/module-auth"
  },
  "homepage": "https://webx-ui.github.io/webx-ui/guide/roadmap.html",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "dependencies": {
    "@webx-ui/admin": "workspace:^",
    "@webx-ui/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.14",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.24",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.1.3"
  }
}
