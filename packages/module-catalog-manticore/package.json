{
  "name": "@webx-ui/module-catalog-manticore",
  "version": "0.2.1",
  "description": "The search index of the WebX UI catalogue on Manticore, in the admin panel: the server, each language's table against the database, the queue, and the rebuild as a job with its progress.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "webx-ui",
    "vue",
    "admin",
    "cms",
    "catalog",
    "e-commerce",
    "manticore",
    "search"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webx-ui/webx-ui.git",
    "directory": "packages/module-catalog-manticore"
  },
  "homepage": "https://github.com/webx-ui/webx-ui/tree/main/packages/module-catalog-manticore",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "dependencies": {
    "@webx-ui/core": "workspace:^",
    "@webx-ui/module-admin": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.14",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.24",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.1.3"
  }
}
