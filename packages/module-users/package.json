{
  "name": "@webx-ui/module-users",
  "version": "0.1.1",
  "description": "Customers in the WebX UI admin panel: the visitors who register and sign in on the site — the list with its filters, the card with the fields of the site, the groups and the ways to sign in, the customer groups, the settings of the registration and the keys of the social networks.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "webx-ui",
    "vue",
    "admin",
    "cms",
    "users",
    "customers",
    "accounts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webx-ui/webx-ui.git",
    "directory": "packages/module-users"
  },
  "homepage": "https://webx-ui.github.io/webx-ui/guide/site-visitors.html",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "dependencies": {
    "@webx-ui/core": "workspace:^",
    "@webx-ui/module-admin": "workspace:^",
    "@webx-ui/schema": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.14",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.24",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.1.3"
  }
}
